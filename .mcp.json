{
  "mcpServers": {
    "tessl": {
      "type": "stdio",
      "command": "tessl",
      "args": [
        "mcp",
        "start"
      ]
    },
    "launchdarkly-token": {
      "type": "http",
      "url": "https://mcp.launchdarkly.com/mcp",
      "headers": {
        "Authorization": "Bearer ${LD_ACCESS_TOKEN}"
      }
    }
  }
}
